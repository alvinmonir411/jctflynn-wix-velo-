import wixData from 'wix-data';

/**
 * Fetch conference rooms from CMS collection
 * Checks all possible collection IDs ('Conferanceroom', 'Conferance room', 'ConferanceRoom', etc.)
 * Uses suppressAuth: true on the backend to guarantee read access regardless of permissions.
 */
export async function getConferenceRooms() {
    const candidates = [
        'Conferanceroom',
        'Conferance room',
        'ConferanceRoom',
        'conferance_room',
        'conferance-room',
        'ConferenceRoom',
        'Conference room',
        'ConferenceRooms',
        'conferanceroom'
    ];

    for (const id of candidates) {
        try {
            const results = await wixData.query(id)
                .limit(50)
                .find({ suppressAuth: true });

            if (results && results.items && results.items.length > 0) {
                console.log(`[Backend] Found ${results.items.length} rooms in collection "${id}"`);
                return results.items;
            }
        } catch (e) {
            // Try next candidate
        }
    }

    console.warn('[Backend] No items found in any candidate room collection IDs.');
    return [];
}
